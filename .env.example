# Copy to .env and set a Gemini API key to enable indexing and search.
GEMINI_API_KEY=
SURV_DATABASE_URL=postgresql:///surveillance_qa
SURV_ADMIN_TOKEN=local-demo-token
# SURV_DATA_DIR=/absolute/path/to/private/storage
# Optional video Q&A model (the embedding model remains gemini-embedding-2).
# SURV_QA_MODEL_ID=gemini-2.5-flash
